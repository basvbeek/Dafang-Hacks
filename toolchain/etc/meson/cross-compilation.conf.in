# Note: Buildroot's and Meson's terminologies differ about the meaning
# of 'build', 'host' and 'target':
# - Buildroot's 'host' is Meson's 'build'
# - Buildroot's 'target' is Meson's 'host'

[binaries]
c = '/github/home/output/toolchain_xburst1_musl_gcc14/host/bin/mipsel-thingino-linux-musl-gcc'
cpp = '/github/home/output/toolchain_xburst1_musl_gcc14/host/bin/mipsel-thingino-linux-musl-g++'
ar = '/github/home/output/toolchain_xburst1_musl_gcc14/host/bin/mipsel-thingino-linux-musl-gcc-ar'
strip = '/github/home/output/toolchain_xburst1_musl_gcc14/host/bin/mipsel-thingino-linux-musl-strip'
cmake = '/usr/bin/cmake'
fortran = '/bin/false'
pkg-config = '/github/home/output/toolchain_xburst1_musl_gcc14/host/bin/pkgconf'
g-ir-compiler = '/github/home/output/toolchain_xburst1_musl_gcc14/host/mipsel-thingino-linux-musl/sysroot/usr/bin/g-ir-compiler'
g-ir-scanner = '/github/home/output/toolchain_xburst1_musl_gcc14/host/mipsel-thingino-linux-musl/sysroot/usr/bin/g-ir-scanner'

[built-in options]
c_args = ['-D_LARGEFILE_SOURCE', '-D_LARGEFILE64_SOURCE', '-D_FILE_OFFSET_BITS=64', '-Os', '-g0'@PKG_TARGET_CFLAGS@]
c_link_args = [@PKG_TARGET_LDFLAGS@]
cpp_args = ['-D_LARGEFILE_SOURCE', '-D_LARGEFILE64_SOURCE', '-D_FILE_OFFSET_BITS=64', '-Os', '-g0'@PKG_TARGET_CXXFLAGS@]
cpp_link_args = [@PKG_TARGET_LDFLAGS@]
fortran_args = ['-Os', '-g0'@PKG_TARGET_FCFLAGS@]
fortran_link_args = [@PKG_TARGET_LDFLAGS@]
wrap_mode = 'nodownload'
cmake_prefix_path = '/github/home/output/toolchain_xburst1_musl_gcc14/host/mipsel-thingino-linux-musl/sysroot/usr/lib/cmake'

[properties]
needs_exe_wrapper = true
sys_root = '/github/home/output/toolchain_xburst1_musl_gcc14/host/mipsel-thingino-linux-musl/sysroot'
pkg_config_libdir = '/github/home/output/toolchain_xburst1_musl_gcc14/host/mipsel-thingino-linux-musl/sysroot/usr/lib/pkgconfig:/github/home/output/toolchain_xburst1_musl_gcc14/host/mipsel-thingino-linux-musl/sysroot/usr/share/pkgconfig'
pkg_config_static = 'false'
# enable meson build to pass a toolchain file to cmake
cmake_toolchain_file = '/github/home/output/toolchain_xburst1_musl_gcc14/host/share/buildroot/toolchainfile.cmake'
cmake_defaults = false

[host_machine]
system = 'linux'
cpu_family = 'mips'
cpu = ''
endian = 'little'
